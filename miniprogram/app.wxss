page {
  background: linear-gradient(180deg, #FFF8E6 0%, #FFFCF3 380rpx, #FFFCF3 100%);
  color: #2B2418;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(120, 88, 20, 0.06);
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2B2418;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F5CC63, #D99A1F);
  margin-right: 14rpx;
  vertical-align: -4rpx;
}

.muted {
  color: #8A7F6B;
  font-size: 24rpx;
}

.tiny {
  color: #A69B87;
  font-size: 22rpx;
}

.row {
  display: flex;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.chip {
  margin: 8rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #FFF7E3;
  color: #5C5140;
  font-size: 24rpx;
  border: 1rpx solid transparent;
  transition: all 0.15s;
}

.chip--active {
  background: #FFF4D6;
  color: #A86F00;
  border-color: #A86F00;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(176, 124, 42, 0.16);
}

.btn-primary {
  background: linear-gradient(135deg, #F6C94F, #E2A72B);
  color: #4A3512;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  letter-spacing: 1rpx;
  box-shadow: 0 14rpx 30rpx rgba(176, 124, 42, 0.28);
}

.btn-primary--disabled {
  background: #E3D6BA;
  box-shadow: none;
}

.btn-ghost {
  border: 1rpx solid #E6D9B9;
  color: #5C5140;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 20rpx 0;
  text-align: center;
  background: #FFFFFF;
}

.btn-mini {
  background: #FFF4D6;
  color: #A86F00;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 26rpx;
  margin-left: 12rpx;
  line-height: 1.4;
}

.link {
  color: #A86F00;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #F2EAD8;
  color: #6B604D;
  margin-right: 10rpx;
}

.tag--blue {
  background: #FFF4D6;
  color: #A86F00;
}

.tag--green {
  background: #E9F8F1;
  color: #1E9E6A;
}

.tag--orange {
  background: #FFF3E4;
  color: #D97B12;
}

.tag--red {
  background: #FFEDEE;
  color: #D5494F;
}

.divider {
  height: 1rpx;
  background: #F0E8D6;
  margin: 24rpx 0;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #A69B87;
  font-size: 26rpx;
}

.bar {
  height: 12rpx;
  background: #F0E8D6;
  border-radius: 8rpx;
  overflow: hidden;
}

.bar__inner {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #F0C36D, #D99A1F);
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
