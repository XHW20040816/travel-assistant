.weather-hero {
  position: relative;
  padding: 36rpx 32rpx 38rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFE9A8 0%, #FFD97C 55%, #F6C24C 100%);
  color: #4A3512;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(176, 124, 42, 0.2);
}

.weather-hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.32);
  pointer-events: none;
}

.weather-hero__title {
  font-size: 34rpx;
  font-weight: 700;
}

.weather-hero__summary {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(74, 53, 18, 0.78);
}

.weather-hero__meta {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: rgba(74, 53, 18, 0.6);
}

.day-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-card__date {
  font-size: 27rpx;
  font-weight: 600;
  color: #2B2418;
}

.day-card__label {
  display: inline-block;
  background: #FFF4D6;
  color: #A86F00;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
}

.day-card__temp {
  font-size: 26rpx;
  color: #8A7F6B;
}

.day-card__high {
  font-size: 38rpx;
  font-weight: 700;
  color: #2B2418;
}

.day-card__low {
  margin-left: 4rpx;
}

.day-card__weather {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5C5140;
}

.day-card__weather .tiny {
  margin-left: 14rpx;
}

.day-card__weather .tag {
  margin-left: 14rpx;
}

.env-grid {
  display: flex;
  background: #FFF9EC;
  border-radius: 16rpx;
  padding: 18rpx 8rpx;
  margin: 20rpx 0;
}

.env {
  flex: 1;
  text-align: center;
}

.env__value {
  font-size: 24rpx;
  font-weight: 600;
  color: #2B2418;
}

.env__label {
  font-size: 20rpx;
  color: #A69B87;
  margin-top: 4rpx;
}

.clothing-block__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.clothing-block__text {
  font-size: 24rpx;
  color: #5C5140;
  margin-top: 12rpx;
  line-height: 1.6;
}

.clothing-items {
  margin-top: 10rpx;
}

.tips {
  margin-top: 12rpx;
  background: #FFFDF7;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

.tip {
  font-size: 22rpx;
  color: #B07C2A;
  line-height: 1.6;
}

.activity {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #A86F00;
  background: #FFFAEA;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.55;
}

.note {
  display: block;
  margin-top: 10rpx;
}

.actions-row {
  display: flex;
}

.actions-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.actions-row .btn-ghost:last-child {
  margin-right: 0;
}
