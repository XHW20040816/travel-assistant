.weather-hero {
  position: relative;
  padding: 36rpx 32rpx 38rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1E2E52 0%, #2B4C87 55%, #2E6BE6 100%);
  color: #FFFFFF;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(27, 42, 74, 0.18);
}

.weather-hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.weather-hero__title {
  font-size: 34rpx;
  font-weight: 700;
}

.weather-hero__summary {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.86);
}

.weather-hero__meta {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.65);
}

.day-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-card__date {
  font-size: 27rpx;
  font-weight: 600;
  color: #14213D;
}

.day-card__label {
  display: inline-block;
  background: #EAF0FF;
  color: #2E6BE6;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
}

.day-card__temp {
  font-size: 26rpx;
  color: #7C879C;
}

.day-card__high {
  font-size: 38rpx;
  font-weight: 700;
  color: #14213D;
}

.day-card__low {
  margin-left: 4rpx;
}

.day-card__weather {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #43516B;
}

.day-card__weather .tiny {
  margin-left: 14rpx;
}

.day-card__weather .tag {
  margin-left: 14rpx;
}

.env-grid {
  display: flex;
  background: #F7F9FD;
  border-radius: 16rpx;
  padding: 18rpx 8rpx;
  margin: 20rpx 0;
}

.env {
  flex: 1;
  text-align: center;
}

.env__value {
  font-size: 24rpx;
  font-weight: 600;
  color: #14213D;
}

.env__label {
  font-size: 20rpx;
  color: #98A2B3;
  margin-top: 4rpx;
}

.clothing-block__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.clothing-block__text {
  font-size: 24rpx;
  color: #43516B;
  margin-top: 12rpx;
  line-height: 1.6;
}

.clothing-items {
  margin-top: 10rpx;
}

.tips {
  margin-top: 12rpx;
  background: #FFFDF7;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

.tip {
  font-size: 22rpx;
  color: #B07C2A;
  line-height: 1.6;
}

.activity {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #2E6BE6;
  background: #F5F8FF;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.55;
}

.note {
  display: block;
  margin-top: 10rpx;
}

.actions-row {
  display: flex;
}

.actions-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.actions-row .btn-ghost:last-child {
  margin-right: 0;
}
