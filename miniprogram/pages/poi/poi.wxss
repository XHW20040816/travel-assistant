.hero {
  position: relative;
  padding: 36rpx 32rpx 38rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFE9A8 0%, #FFD97C 55%, #F6C24C 100%);
  color: #4A3512;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(176, 124, 42, 0.2);
}

.hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.32);
  pointer-events: none;
}

.hero__top {
  display: flex;
  align-items: center;
}

.hero__score {
  margin-left: auto;
  font-size: 40rpx;
  font-weight: 700;
}

.hero__name {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(74, 53, 18, 0.72);
}

.hero__meta text {
  margin-right: 8rpx;
}

.hero__day {
  margin-top: 14rpx;
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  font-size: 22rpx;
}

.hero__tags {
  margin-top: 16rpx;
}

.hero__tags .tag {
  background: rgba(255, 255, 255, 0.55);
  color: #4A3512;
}

.score-line {
  display: flex;
  align-items: flex-start;
}

.score-big {
  width: 120rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #A86F00;
  line-height: 1.1;
  flex-shrink: 0;
}

.score-side {
  flex: 1;
}

.reason {
  font-size: 24rpx;
  color: #5C5140;
  line-height: 1.65;
}

.parts-title {
  margin-bottom: 14rpx;
}

.part {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.part__label {
  width: 130rpx;
  font-size: 23rpx;
  color: #6B604D;
  flex-shrink: 0;
}

.part__bar {
  flex: 1;
  height: 12rpx;
  background: #F0E8D6;
  border-radius: 8rpx;
  overflow: hidden;
}

.part__inner {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #A86F00, #E3A72D);
}

.part__value {
  width: 70rpx;
  text-align: right;
  font-size: 22rpx;
  color: #A69B87;
}

.info-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row__label {
  width: 150rpx;
  font-size: 24rpx;
  color: #8A7F6B;
  flex-shrink: 0;
}

.info-row__value {
  flex: 1;
  font-size: 25rpx;
  color: #2B2418;
  line-height: 1.6;
}

.tips {
  font-size: 25rpx;
  color: #5C5140;
  line-height: 1.7;
  background: #FFF9EC;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}

.guide {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.guide:last-of-type {
  border-bottom: none;
}

.guide__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide__title {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #2B2418;
  line-height: 1.45;
}

.guide__summary {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6B604D;
  line-height: 1.6;
}

.note {
  font-size: 23rpx;
  color: #8A7F6B;
  line-height: 1.7;
}

.actions {
  margin-top: 8rpx;
}

.actions-row {
  display: flex;
  margin-top: 16rpx;
}

.actions-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.actions-row .btn-ghost:last-child {
  margin-right: 0;
}

.empty-btn {
  margin-top: 24rpx;
  padding: 18rpx 0;
}
