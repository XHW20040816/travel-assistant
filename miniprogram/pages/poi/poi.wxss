.hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #22345C, #2E6BE6);
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.hero__top {
  display: flex;
  align-items: center;
}

.hero__score {
  margin-left: auto;
  font-size: 40rpx;
  font-weight: 700;
}

.hero__name {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero__meta text {
  margin-right: 8rpx;
}

.hero__day {
  margin-top: 14rpx;
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.hero__tags {
  margin-top: 16rpx;
}

.hero__tags .tag {
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
}

.score-line {
  display: flex;
  align-items: flex-start;
}

.score-big {
  width: 120rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #2E6BE6;
  line-height: 1.1;
  flex-shrink: 0;
}

.score-side {
  flex: 1;
}

.reason {
  font-size: 24rpx;
  color: #43516B;
  line-height: 1.65;
}

.parts-title {
  margin-bottom: 14rpx;
}

.part {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.part__label {
  width: 130rpx;
  font-size: 23rpx;
  color: #55627A;
  flex-shrink: 0;
}

.part__bar {
  flex: 1;
  height: 12rpx;
  background: #EEF1F6;
  border-radius: 8rpx;
  overflow: hidden;
}

.part__inner {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #2E6BE6, #2AA0E6);
}

.part__value {
  width: 70rpx;
  text-align: right;
  font-size: 22rpx;
  color: #98A2B3;
}

.info-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0F3F9;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row__label {
  width: 150rpx;
  font-size: 24rpx;
  color: #7C879C;
  flex-shrink: 0;
}

.info-row__value {
  flex: 1;
  font-size: 25rpx;
  color: #1B2333;
  line-height: 1.6;
}

.tips {
  font-size: 25rpx;
  color: #43516B;
  line-height: 1.7;
  background: #F8FAFD;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}

.guide {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F3F9;
}

.guide:last-of-type {
  border-bottom: none;
}

.guide__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide__title {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #14213D;
  line-height: 1.45;
}

.guide__summary {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #55627A;
  line-height: 1.6;
}

.note {
  font-size: 23rpx;
  color: #7C879C;
  line-height: 1.7;
}

.actions {
  margin-top: 8rpx;
}

.actions-row {
  display: flex;
  margin-top: 16rpx;
}

.actions-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.actions-row .btn-ghost:last-child {
  margin-right: 0;
}

.empty-btn {
  margin-top: 24rpx;
  padding: 18rpx 0;
}
