.help-hero {
  position: relative;
  padding: 36rpx 32rpx 38rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFE9A8 0%, #FFD97C 55%, #F6C24C 100%);
  color: #4A3512;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(176, 124, 42, 0.2);
}

.help-hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.32);
  pointer-events: none;
}

.help-hero__title {
  font-size: 38rpx;
  font-weight: 700;
}

.help-hero__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(74, 53, 18, 0.72);
}

.help-hero__meta {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  color: #4A3512;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.status-row:last-of-type {
  border-bottom: none;
}

.status-row__label {
  font-size: 24rpx;
  color: #6B604D;
}

.status-row__value {
  font-size: 24rpx;
  font-weight: 600;
  color: #2B2418;
}

.status-row__value.ok {
  color: #1E9E6A;
}

.status-row__value.warn {
  color: #D97B12;
}

.btn-row {
  display: flex;
  margin-top: 20rpx;
}

.btn-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.btn-row .btn-ghost:last-child {
  margin-right: 0;
}

.step {
  display: flex;
  margin-top: 16rpx;
}

.step__no {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #FFF4D6;
  color: #A86F00;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  margin-right: 16rpx;
}

.step__body {
  flex: 1;
}

.step__text {
  font-size: 24rpx;
  color: #6B604D;
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.step__hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A69B87;
  line-height: 1.6;
}

.step__link {
  color: #A86F00;
  text-decoration: underline;
}

.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: 23rpx;
  color: #2B2418;
  background: #FFF9EC;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.faq {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.faq:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.faq__q {
  font-size: 25rpx;
  font-weight: 600;
  color: #2B2418;
  line-height: 1.5;
}

.faq__a {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8A7F6B;
  line-height: 1.65;
}

.source-line {
  font-size: 23rpx;
  color: #8A7F6B;
  line-height: 1.7;
}

.bullet {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6B604D;
  line-height: 1.7;
}

.bullet__dot {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: #A86F00;
  font-weight: 700;
}

.module {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.module:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.module__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2B2418;
}

.module__desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A7F6B;
  line-height: 1.65;
}
