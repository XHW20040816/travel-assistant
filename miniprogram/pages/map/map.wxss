.map-page {
  padding: 0 0 60rpx;
}

.day-tabs {
  white-space: nowrap;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
}

.day-tab {
  display: inline-block;
  vertical-align: top;
  min-width: 150rpx;
  padding: 14rpx 18rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  background: #FFF9EC;
  border: 1rpx solid transparent;
}

.day-tab--active {
  background: #FFF4D6;
  border-color: #A86F00;
}

.day-tab__label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2B2418;
}

.day-tab__date {
  display: block;
  font-size: 21rpx;
  color: #8A7F6B;
  margin-top: 2rpx;
}

.day-tab__weather {
  display: block;
  font-size: 21rpx;
  color: #A86F00;
  margin-top: 2rpx;
}

.map-card {
  position: relative;
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(176, 124, 42, 0.16);
}

.map {
  width: 100%;
  height: 560rpx;
}

.legend {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  display: flex;
  flex-direction: column;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #6B604D;
  margin: 3rpx 0;
}

.legend-line {
  width: 36rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #A86F00;
  margin-right: 10rpx;
}

.legend-line--dashed {
  background: repeating-linear-gradient(90deg, #8A7F6B 0, #8A7F6B 8rpx, transparent 8rpx, transparent 14rpx);
}

.day-info {
  margin: 0 24rpx 24rpx;
}

.day-info__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-info__date {
  font-size: 30rpx;
  font-weight: 700;
  color: #2B2418;
}

.day-info__weather {
  font-size: 24rpx;
  color: #A86F00;
  background: #FFF4D6;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
}

.day-info__tags {
  margin: 14rpx 0 10rpx;
}

.leg {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.leg:last-of-type {
  border-bottom: none;
}

.leg__badge {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 24rpx;
  background: #FFF4D6;
  color: #A86F00;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.leg__badge--transit {
  background: #E9F8F1;
  color: #1E9E6A;
}

.leg__badge--taxi,
.leg__badge--drive {
  background: #FFF3E4;
  color: #D97B12;
}

.leg__body {
  flex: 1;
  min-width: 0;
}

.leg__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2B2418;
  line-height: 1.4;
}

.leg__meta {
  font-size: 22rpx;
  color: #8A7F6B;
  margin-top: 4rpx;
}

.leg__meta text {
  margin-right: 6rpx;
}

.leg__warn {
  color: #D97B12;
}

.leg__modes {
  display: flex;
  margin-top: 10rpx;
}

.mode {
  font-size: 21rpx;
  color: #6B604D;
  background: #FFF9EC;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-right: 10rpx;
  border: 1rpx solid transparent;
}

.mode--active {
  background: #FFF4D6;
  color: #A86F00;
  border-color: #A86F00;
}

.leg__nav {
  flex-shrink: 0;
  font-size: 23rpx;
  color: #A86F00;
  padding: 8rpx 0 8rpx 16rpx;
}

.actions-row {
  display: flex;
  padding: 0 24rpx;
}

.actions-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.actions-row .btn-ghost:last-child {
  margin-right: 0;
}
