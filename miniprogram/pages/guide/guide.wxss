.guide-hero {
  position: relative;
  padding: 36rpx 32rpx 38rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFE9A8 0%, #FFD97C 55%, #F6C24C 100%);
  color: #4A3512;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(176, 124, 42, 0.2);
}

.guide-hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.32);
  pointer-events: none;
}

.guide-hero__title {
  font-size: 38rpx;
  font-weight: 700;
}

.guide-hero__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(74, 53, 18, 0.72);
}

.guide-hero__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.guide-hero__badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  color: #4A3512;
}

.guide-hero__refresh {
  font-size: 24rpx;
  color: #6B4A12;
  opacity: 0.9;
  padding: 6rpx 0 6rpx 24rpx;
}

.notice__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2418;
}

.notice__text {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #8A7F6B;
}

.notice__actions {
  margin-top: 18rpx;
  display: flex;
}

.notice__actions .btn-mini {
  margin-left: 0;
  margin-right: 16rpx;
}

.notice--info {
  background: #FFFAEE;
}

.notice--warn {
  background: #FFFBF4;
  border-left: 6rpx solid #F0A020;
}

.loading-card__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #2B2418;
}

.loading-card__bar {
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #F4EBD9;
  margin: 18rpx 0 12rpx;
}

.loading-card__bar-inner {
  width: 40%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #A86F00, #E3A72D);
  animation: loading-slide 1.2s ease-in-out infinite;
}

@keyframes loading-slide {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(250%);
  }
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 18rpx;
}

.list-note {
  padding: 0 4rpx 16rpx;
  line-height: 1.6;
}

.help-entry {
  display: flex;
  align-items: center;
}

.help-entry__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #2B2418;
}

.city-scroll {
  white-space: nowrap;
  margin: 0 -8rpx;
}

.city-scroll .chip {
  display: inline-block;
}

/* 「其他」平台：自定义平台名输入 */
.custom-platform {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0 8rpx;
}

.custom-platform__input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #2B2418;
  background: #FFF9EC;
  border-radius: 16rpx;
}

.custom-platform__ph {
  color: #A69B87;
}

.custom-platform__btn {
  flex-shrink: 0;
  height: 80rpx;
  display: flex;
  align-items: center;
}

.search-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.search-row:last-of-type {
  border-bottom: none;
}

.search-row__label {
  width: 120rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2B2418;
  flex-shrink: 0;
}

.search-row__text {
  flex: 1;
  font-size: 22rpx;
  color: #8A7F6B;
  margin-right: 12rpx;
}

.search-note {
  display: block;
  margin-top: 14rpx;
  line-height: 1.6;
}

.guide-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide-card__title {
  font-size: 29rpx;
  font-weight: 700;
  color: #2B2418;
  line-height: 1.45;
  margin-top: 12rpx;
}

.guide-card__meta {
  font-size: 22rpx;
  color: #A69B87;
  margin-top: 6rpx;
}

.guide-card__meta text {
  margin-right: 6rpx;
}

.guide-card__summary {
  font-size: 24rpx;
  color: #6B604D;
  line-height: 1.6;
  margin-top: 12rpx;
}

.points {
  margin-top: 12rpx;
  background: #FFF9EC;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
}

.point {
  font-size: 23rpx;
  color: #5C5140;
  line-height: 1.65;
}

.guide-card__tags {
  margin-top: 12rpx;
}

.guide-card__actions {
  margin-top: 10rpx;
  display: flex;
  justify-content: flex-end;
}

.guide-card__actions .link {
  margin-left: 32rpx;
}

.stale {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #D97B12;
  background: #FFF9F1;
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
}

.source-card .section-title {
  margin-bottom: 12rpx;
}

.source-line {
  font-size: 23rpx;
  color: #8A7F6B;
  line-height: 1.7;
}

.city-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.city-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFF9EC;
  font-size: 27rpx;
  color: #2B2418;
}

.city-input__ph {
  color: #A79C88;
}

.city-input__btn {
  flex: none;
  height: 80rpx;
  display: flex;
  align-items: center;
}

.city-input__note {
  margin-top: 12rpx;
  color: #8A8070;
}

.dest-actions {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.dest-actions .link {
  margin-right: 24rpx;
}

.dest-actions .link--muted {
  color: #A69B87;
}

.dest-point {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #FFF9EC;
  font-size: 24rpx;
  color: #5C5140;
}

.dest-point .tag {
  margin-right: 12rpx;
}

.dest-point .tiny {
  width: 100%;
  margin-top: 4rpx;
}

.spot-plan-btn {
  margin-top: 22rpx;
}
