.mine-hero {
  position: relative;
  padding: 36rpx 32rpx 38rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFE9A8 0%, #FFD97C 55%, #F6C24C 100%);
  color: #4A3512;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(176, 124, 42, 0.2);
}

.mine-hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.32);
  pointer-events: none;
}

.mine-hero__title {
  font-size: 38rpx;
  font-weight: 700;
}

.mine-hero__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(74, 53, 18, 0.72);
}

.mine-hero__stats {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(74, 53, 18, 0.16);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat__value {
  font-size: 34rpx;
  font-weight: 700;
}

.stat__label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(74, 53, 18, 0.65);
}

.option {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #F0E8D6;
  margin-top: 16rpx;
  background: #FFFDF7;
}

.option--active {
  border-color: #A86F00;
  background: #FFFAEA;
}

.option__radio {
  width: 40rpx;
  font-size: 28rpx;
  color: #A86F00;
  line-height: 1.4;
  flex-shrink: 0;
}

.option__body {
  flex: 1;
}

.option__label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2418;
}

.option__desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A7F6B;
  line-height: 1.6;
}

.field {
  margin-top: 20rpx;
}

.field__label {
  display: block;
  font-size: 24rpx;
  color: #6B604D;
  margin-bottom: 10rpx;
}

.field__input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFF9EC;
  font-size: 25rpx;
  color: #2B2418;
}

.badge-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.badge {
  margin-right: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F2EAD8;
  color: #8A7F6B;
  font-size: 22rpx;
  flex-shrink: 0;
}

.badge--on {
  background: #FFF4D6;
  color: #A86F00;
}

.btn-row {
  display: flex;
  margin-top: 22rpx;
}

.btn-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.btn-row .btn-ghost:last-child {
  margin-right: 0;
}

.cache-row {
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  color: #5C5140;
}

.cache-row .tiny {
  margin-top: 6rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.menu-row:last-of-type {
  border-bottom: none;
}

.menu-row__label {
  flex: 1;
  font-size: 28rpx;
  color: #2B2418;
}

.menu-row__arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #C9BFA9;
}

.history {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2EAD8;
}

.history:last-of-type {
  border-bottom: none;
}

.history__main {
  flex: 1;
}

.history__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2418;
}

.history__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.history__del {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #D5494F;
}

.empty-block {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.empty-block__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2418;
  margin-bottom: 8rpx;
}

.empty-btn {
  margin: 22rpx 40rpx 0;
  padding: 16rpx 0;
}

.source-line {
  font-size: 23rpx;
  color: #8A7F6B;
  line-height: 1.7;
}

.version {
  display: block;
  margin-top: 18rpx;
  text-align: center;
}
