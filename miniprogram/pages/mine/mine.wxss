.mine-hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #22345C, #2E6BE6);
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.mine-hero__title {
  font-size: 38rpx;
  font-weight: 700;
}

.mine-hero__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

.mine-hero__status {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  font-size: 23rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #39D98A;
  margin-right: 10rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #EEF1F6;
  margin-bottom: 14rpx;
  background: #FBFCFE;
}

.option--active {
  border-color: #2E6BE6;
  background: #F5F8FF;
}

.option__radio {
  width: 40rpx;
  font-size: 28rpx;
  color: #2E6BE6;
  line-height: 1.4;
  flex-shrink: 0;
}

.option__body {
  flex: 1;
}

.option__label {
  font-size: 28rpx;
  font-weight: 600;
  color: #14213D;
}

.option__desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7C879C;
  line-height: 1.6;
}

.warn {
  display: block;
  margin-top: 6rpx;
  line-height: 1.6;
  color: #D97B12;
}

.provider-desc {
  display: block;
  margin: 10rpx 0 6rpx;
  line-height: 1.6;
}

.field {
  margin-top: 20rpx;
}

.field__label {
  display: block;
  font-size: 24rpx;
  color: #55627A;
  margin-bottom: 10rpx;
}

.field__input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #F5F7FB;
  font-size: 25rpx;
  color: #1B2333;
}

.btn-row {
  display: flex;
  margin-top: 22rpx;
}

.btn-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.btn-row .btn-ghost:last-child {
  margin-right: 0;
}

.step-line {
  font-size: 23rpx;
  color: #55627A;
  line-height: 1.7;
}

.link-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F3F9;
}

.link-row:last-of-type {
  border-bottom: none;
}

.link-row__label {
  font-size: 24rpx;
  color: #14213D;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.link-row__text {
  flex: 1;
  font-size: 21rpx;
  color: #98A2B3;
  margin-right: 12rpx;
}

.cache-row {
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  color: #43516B;
}

.cache-row .tiny {
  margin-top: 6rpx;
}

.history {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F3F9;
}

.history:last-of-type {
  border-bottom: none;
}

.history__main {
  flex: 1;
}

.history__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #14213D;
}

.history__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.history__del {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #D5494F;
}

.empty-block {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.empty-btn {
  margin: 22rpx 40rpx 0;
  padding: 16rpx 0;
}

.source-line {
  font-size: 23rpx;
  color: #7C879C;
  line-height: 1.7;
}

.version {
  display: block;
  margin-top: 18rpx;
  text-align: center;
}
