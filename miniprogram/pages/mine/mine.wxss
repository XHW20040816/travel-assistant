.mine-hero {
  position: relative;
  padding: 36rpx 32rpx 38rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1E2E52 0%, #2B4C87 55%, #2E6BE6 100%);
  color: #FFFFFF;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(27, 42, 74, 0.18);
}

.mine-hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.mine-hero__title {
  font-size: 38rpx;
  font-weight: 700;
}

.mine-hero__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

.mine-hero__stats {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat__value {
  font-size: 34rpx;
  font-weight: 700;
}

.stat__label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
}

.option {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #EEF1F6;
  margin-top: 16rpx;
  background: #FBFCFE;
}

.option--active {
  border-color: #2E6BE6;
  background: #F5F8FF;
}

.option__radio {
  width: 40rpx;
  font-size: 28rpx;
  color: #2E6BE6;
  line-height: 1.4;
  flex-shrink: 0;
}

.option__body {
  flex: 1;
}

.option__label {
  font-size: 28rpx;
  font-weight: 600;
  color: #14213D;
}

.option__desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7C879C;
  line-height: 1.6;
}

.field {
  margin-top: 20rpx;
}

.field__label {
  display: block;
  font-size: 24rpx;
  color: #55627A;
  margin-bottom: 10rpx;
}

.field__input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #F5F7FB;
  font-size: 25rpx;
  color: #1B2333;
}

.badge-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.badge {
  margin-right: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F0F3F9;
  color: #7C879C;
  font-size: 22rpx;
  flex-shrink: 0;
}

.badge--on {
  background: #EAF2FF;
  color: #2E6BE6;
}

.btn-row {
  display: flex;
  margin-top: 22rpx;
}

.btn-row .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
}

.btn-row .btn-ghost:last-child {
  margin-right: 0;
}

.cache-row {
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  color: #43516B;
}

.cache-row .tiny {
  margin-top: 6rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F3F9;
}

.menu-row:last-of-type {
  border-bottom: none;
}

.menu-row__label {
  flex: 1;
  font-size: 28rpx;
  color: #14213D;
}

.menu-row__arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #B4BDCC;
}

.history {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F3F9;
}

.history:last-of-type {
  border-bottom: none;
}

.history__main {
  flex: 1;
}

.history__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #14213D;
}

.history__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.history__del {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #D5494F;
}

.empty-block {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.empty-block__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #14213D;
  margin-bottom: 8rpx;
}

.empty-btn {
  margin: 22rpx 40rpx 0;
  padding: 16rpx 0;
}

.source-line {
  font-size: 23rpx;
  color: #7C879C;
  line-height: 1.7;
}

.version {
  display: block;
  margin-top: 18rpx;
  text-align: center;
}
